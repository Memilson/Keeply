# Configurações de Ambiente Keeply (TEMPLATE)
# Preencha com os dados do seu ambiente local ou de produção.

# Backend / PostgreSQL
POSTGRES_DB=keeply
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/keeply
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# Security
KEEPLY_JWT_SECRET=change-me-com-32-caracteres-ou-mais
KEEPLY_MASTER_KEY=change-me-com-chave-mestra-segura-hex-64-caracteres

# MinIO
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
KEEPLY_MINIO_ENDPOINT=http://localhost:9000
KEEPLY_MINIO_ACCESS_KEY=change-me
KEEPLY_MINIO_SECRET_KEY=change-me
KEEPLY_MINIO_BUCKET=keeply

# Keeply I.A / OpenRouter
KEEPLY_AI_BASE_URL=https://openrouter.ai/api/v1
KEEPLY_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
KEEPLY_AI_API_KEY=sk-or-v1-sua-chave-openrouter
KEEPLY_AI_TITLE=Keeply
KEEPLY_AI_REFERER=http://localhost:3000
