<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.keeply.agent.ui.MainShellController" styleClass="app-shell">
    <left>
        <VBox styleClass="app-sidebar" prefWidth="240" spacing="8">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="shell-brand-box">
                <StackPane prefWidth="24" prefHeight="24">
                    <SVGPath content="M12 0l2.7 6.3L21 9l-6.3 2.7L12 18l-2.7-6.3L3 9l6.3-2.7L12 0z" style="-fx-fill: #7B61FF;"/>
                </StackPane>
                <Label text="Keeply" styleClass="shell-brand"/>
            </HBox>
            
            <VBox fx:id="navMenu" spacing="4" styleClass="shell-navigation" VBox.vgrow="NEVER">
                <!-- Buttons added dynamically or injected via FXML -->
                <Button fx:id="btnInicio" text="Início" styleClass="nav-button, active-nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnMeusArquivos" text="Meus arquivos" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnBackups" text="Proteção" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.92c.04-.34.07-.68.07-1.08s-.03-.73-.07-1.08l2.34-1.82c.21-.17.27-.47.13-.71l-2.22-3.84c-.14-.24-.44-.32-.68-.24l-2.76 1.11c-.58-.44-1.2-.82-1.88-1.09l-.42-2.93A.54.54 0 0 0 14 3h-4c-.27 0-.5.19-.53.46l-.42 2.93c-.68.27-1.3.65-1.88 1.09L4.41 6.37c-.24-.08-.54 0-.68.24L1.51 10.45c-.14.24-.08.54.13.71l2.34 1.82c-.04.35-.07.69-.07 1.08s.03.73.07 1.08L1.64 17c-.21.17-.27.47-.13.71l2.22 3.84c.14.24.44.32.68.24l2.76-1.11c.58.44 1.2.82 1.88 1.09l.42 2.93c.03.27.26.46.53.46h4c.27 0 .5-.19.53-.46l.42-2.93c.68-.27 1.3-.65 1.88-1.09l2.76 1.11c.24.08.54 0 .68-.24l2.22-3.84c.14-.24.08-.54-.13-.71l-2.34-1.82z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnAtividade" text="Atividade" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Storage Card -->
            <VBox styleClass="storage-card" spacing="10">
                <Label text="Armazenamento" styleClass="storage-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="4">
                    <Label fx:id="lblStorageUsed" text="—" styleClass="storage-used"/>
                    <Label text="de 1 TB" styleClass="storage-total"/>
                </HBox>
                <ProgressBar fx:id="pbStorage" progress="0" prefWidth="200" styleClass="storage-progress"/>
                <Label fx:id="lblStoragePercent" text="" styleClass="storage-percent"/>
                <Button text="Gerenciar plano" styleClass="btn-manage-plan" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" styleClass="btn-icon-purple"/>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>
    
    <center>
        <BorderPane styleClass="workspace">
            <top>
                <HBox fx:id="appHeader" styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Profile -->
                    <HBox fx:id="profileBox" alignment="CENTER" spacing="8" styleClass="profile-box">
                        <StackPane>
                            <Circle radius="14" fill="#7B61FF"/>
                            <Label fx:id="lblProfileInitials" text="" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        </StackPane>
                        <Label fx:id="lblProfileName" text="" styleClass="profile-name"/>
                        <SVGPath content="M7 10l5 5 5-5z" styleClass="header-icon"/>
                    </HBox>
                    <Button fx:id="btnClose" text="" styleClass="window-close-button" focusTraversable="false">
                        <graphic>
                            <SVGPath content="M6 6l12 12M18 6L6 18" styleClass="window-close-icon"/>
                        </graphic>
                    </Button>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentHost" styleClass="content-host">
                    <!-- Dynamic Content Here -->
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
