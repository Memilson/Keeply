<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.keeply.agent.ui.MainShellController" styleClass="app-shell">
    <left>
        <VBox styleClass="app-sidebar" prefWidth="240" spacing="8">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="shell-brand-box">
                <StackPane prefWidth="24" prefHeight="24">
                    <SVGPath content="M12 0l2.7 6.3L21 9l-6.3 2.7L12 18l-2.7-6.3L3 9l6.3-2.7L12 0z" style="-fx-fill: #6D47FF;"/>
                </StackPane>
                <Label text="Keeply" styleClass="shell-brand"/>
            </HBox>
            
            <VBox fx:id="navMenu" spacing="4" styleClass="shell-navigation" VBox.vgrow="NEVER">
                <!-- Buttons added dynamically or injected via FXML -->
                <Button fx:id="btnInicio" text="Início" styleClass="nav-button, active-nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnMeusArquivos" text="Meus arquivos" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnBackups" text="Backups" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnSnapshots" text="Snapshots" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnRestaurar" text="Restaurar" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnCompartilhado" text="Compartilhado" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnAtividade" text="Atividade" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnConfiguracoes" text="Configurações" styleClass="nav-button" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <SVGPath content="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" styleClass="nav-icon"/>
                    </graphic>
                </Button>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Storage Card -->
            <VBox styleClass="storage-card" spacing="10">
                <Label text="Armazenamento" styleClass="storage-title"/>
                <HBox alignment="BASELINE_LEFT" spacing="4">
                    <Label text="256" styleClass="storage-used"/>
                    <Label text="GB de 1 TB" styleClass="storage-total"/>
                </HBox>
                <ProgressBar progress="0.256" prefWidth="200" styleClass="storage-progress"/>
                <Label text="25% usado" styleClass="storage-percent"/>
                <Button text="Gerenciar plano" styleClass="btn-manage-plan" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" styleClass="btn-icon-purple"/>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>
    
    <center>
        <BorderPane styleClass="workspace">
            <top>
                <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="16">
                    <TextField fx:id="searchField" promptText="Buscar arquivos, pastas ou snapshots..." styleClass="top-search-field" prefWidth="320"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Notifications -->
                    <StackPane styleClass="icon-btn">
                        <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z" styleClass="header-icon"/>
                    </StackPane>
                    <!-- Help -->
                    <StackPane styleClass="icon-btn">
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z" styleClass="header-icon"/>
                    </StackPane>
                    <!-- Profile -->
                    <HBox alignment="CENTER" spacing="8" styleClass="profile-box">
                        <StackPane>
                            <Circle radius="14" fill="#6D47FF"/>
                            <Label fx:id="lblProfileInitials" text="MO" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        </StackPane>
                        <Label fx:id="lblProfileName" text="Convidado" styleClass="profile-name"/>
                        <SVGPath content="M7 10l5 5 5-5z" styleClass="header-icon"/>
                    </HBox>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentHost" styleClass="content-host">
                    <!-- Dynamic Content Here -->
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
